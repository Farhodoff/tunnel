# Tunnel Server Environment Configuration
# Copy: cp .env.example .env   (VPS: /opt/tunnel/.env)

# Server Settings
TUNNEL_DOMAIN=tunnel.example.com
# Optional exact custom-domain routing: domain=subdomain, comma separated.
# DNS A/AAAA records for each domain must point to this server.
TUNNEL_CUSTOM_DOMAINS=api.example.com=myapp
TUNNEL_PORT=8080
TUNNEL_HOST=0.0.0.0

# Security (REQUIRED in prod: comma-separated keys, clients pass --token)
TUNNEL_API_KEYS=your_api_key_1,your_api_key_2
# JSON persistence for keys created via POST /api/keys (survives restarts)
TUNNEL_API_KEYS_FILE=./api_keys.json

# SSL/TLS (optional - for custom certificates)
TUNNEL_SSL_CERT=/path/to/cert.pem
TUNNEL_SSL_KEY=/path/to/key.pem

# Rate Limiting
TUNNEL_RATE_LIMIT=100
TUNNEL_RATE_WINDOW=60

# Redis (distributed rate limiting; Docker: redis://redis:6379/0 with --profile with-redis)
TUNNEL_REDIS_URL=

# TCP forwarding: public ports are chosen per-tunnel via --tcp-port (0=auto).
# If fixed ports are used, expose them in docker-compose ports and open UFW.
# Example: client --tcp --tcp-port 19000  ->  server must listen on 19000.

# Logging (systemd deploy uses journald; file path is for manual runs only)
TUNNEL_LOG_LEVEL=INFO
TUNNEL_LOG_FILE=/var/log/tunnel/server.log
# Request/webhook retention and payload safety limits
TUNNEL_LOG_RETENTION=86400
TUNNEL_WEBHOOK_RETENTION=86400
TUNNEL_WEBHOOK_MAX_BODY=1048576
TUNNEL_WEBHOOK_STORE=/app/data/webhooks.json
